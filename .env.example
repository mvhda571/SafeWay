# JWT signing secret for session cookies (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Telegram alerts for new 🔴 high hazards. Leave empty for simulation mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone number for the "School inspector" button in the SOS panel
NEXT_PUBLIC_INSPECTOR_PHONE=+998712000000

# Only needed when you migrate from the built-in JSON store to PostgreSQL + PostGIS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safeway

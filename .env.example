# MongoDB Atlas connection string (required). The database name goes at the end: /safeway
# Atlas → Network Access must allow 0.0.0.0/0 so Netlify functions can connect.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/safeway?retryWrites=true&w=majority

# JWT signing secret for session cookies. Optional: if empty, a random secret is generated once
# and stored in MongoDB (`meta` collection).
AUTH_SECRET=

# Telegram alerts for new 🔴 high hazards, posted to the parents' channel.
# Add the bot to the channel as an admin. Channel id: @channel_username or -100xxxxxxxxxx.
# Leave empty for simulation mode (message is only shown in the admin panel).
BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Public site URL used for the hazard link in Telegram messages. Optional: on Netlify the
# built-in URL variable or the request origin is used.
SITE_URL=

# Telegram bot username (without @) for the "Get alerts in Telegram" link on /profile.
# Inlined at build time; the link is hidden when empty.
NEXT_PUBLIC_BOT_USERNAME=

# Phone number for the "School inspector" button in the SOS panel (inlined at build time)
NEXT_PUBLIC_INSPECTOR_PHONE=+998712000000

# true → demo accounts (parent / school / admin) are shown on the login page. Read at build time.
DEMO_MODE=false

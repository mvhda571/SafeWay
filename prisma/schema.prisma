// Production schema for PostgreSQL + PostGIS.
// The app ships with a zero-setup JSON store (lib/store.ts) whose functions map 1:1 to these models.
// To migrate: `npm i -D prisma && npm i @prisma/client`, set DATABASE_URL, `npx prisma migrate dev`,
// then run prisma/postgis.sql and reimplement lib/store.ts with Prisma calls.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  parent
  school_admin
  super_admin
}

enum Category {
  open_manhole
  unlit_street
  stray_dogs
  speeding
}

enum Severity {
  low
  medium
  high
}

enum Status {
  active
  investigating
  resolved
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(parent)
  createdAt     DateTime       @default(now())
  hazards       Hazard[]
  confirmations Confirmation[]
}

model Hazard {
  id            String                                @id @default(uuid())
  title         String
  description   String                                @default("")
  category      Category
  severity      Severity
  status        Status                                @default(active)
  lat           Float
  lng           Float
  /// Maintained by trigger in postgis.sql; used for radius queries (ST_DWithin)
  location      Unsupported("geography(Point, 4326)")?
  imageUrl      String?
  createdBy     String
  author        User                                  @relation(fields: [createdBy], references: [id])
  confirmations Confirmation[]
  telegramLogs  TelegramLog[]
  createdAt     DateTime                              @default(now())
  updatedAt     DateTime                              @updatedAt

  @@index([status, category])
}

/// "+1 I saw it too" — one vote per user per hazard
model Confirmation {
  userId    String
  hazardId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hazard    Hazard   @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, hazardId])
}

model TelegramLog {
  id        String   @id @default(uuid())
  hazardId  String
  hazard    Hazard   @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  text      String
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())
}
